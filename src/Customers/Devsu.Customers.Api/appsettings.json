{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Outbox": {
    "BatchSize": 20,
    "PollingInterval": "00:00:01",
    "LeaseDuration": "00:00:30",
    "BaseRetryDelay": "00:00:02",
    "MaximumRetryDelay": "00:05:00"
  },
  "RabbitMq": {
