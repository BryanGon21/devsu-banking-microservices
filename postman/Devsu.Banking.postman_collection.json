            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const transientVariables = [",
                  "    'joseCustomerId', 'marianelaCustomerId', 'juanCustomerId',",
                  "    'movement478758Id', 'movement225487Id', 'movement495878Id', 'movement496825Id',",
                  "    'retryAccount478758', 'retryAccount225487', 'retryAccount495878',",
                  "    'retryAccount496825', 'retryAccount585545'",
                  "];",
                  "transientVariables.forEach(function (name) { pm.collectionVariables.unset(name); });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Customers Service está ready', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.text()).to.eql('Healthy');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{customersBaseUrl}}/health/ready",
            "description": "Inicializa las variables transitorias y comprueba Customers Service."
