    {
      "name": "04 - Reportes",
      "item": [
        {
          "name": "Get Marianela February 2022 statement",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Reporte de Marianela coincide con el enunciado', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.cliente.clienteId).to.eql(pm.collectionVariables.get('marianelaCustomerId'));",
                  "    pm.expect(body.cliente.nombre).to.eql('Marianela Montalvo');",
                  "    pm.expect(body).to.include({ fechaInicio: '2022-02-01', fechaFin: '2022-02-28' });",
                  "    pm.expect(body.cuentas).to.be.an('array').with.lengthOf(2);",
                  "    const checking = body.cuentas.find(function (account) { return account.numeroCuenta === '225487'; });",
                  "    const savings = body.cuentas.find(function (account) { return account.numeroCuenta === '496825'; });",
                  "    pm.expect(checking).to.exist;",
                  "    pm.expect(checking).to.include({ tipoCuenta: 'Corriente', saldoInicial: 100, saldoInicioPeriodo: 100, saldoFinPeriodo: 700, saldoActual: 700, estado: true });",
                  "    pm.expect(checking.movimientos).to.have.lengthOf(1);",
                  "    pm.expect(checking.movimientos[0]).to.include({ tipoMovimiento: 'Deposito', valor: 600, saldoDisponible: 700 });",
                  "    pm.expect(checking.movimientos[0].fecha).to.match(/^2022-02-10T00:00:00/);",
                  "    pm.expect(savings).to.exist;",
                  "    pm.expect(savings).to.include({ tipoCuenta: 'Ahorros', saldoInicial: 540, saldoInicioPeriodo: 540, saldoFinPeriodo: 0, saldoActual: 0, estado: true });",
                  "    pm.expect(savings.movimientos).to.have.lengthOf(1);",
                  "    pm.expect(savings.movimientos[0]).to.include({ tipoMovimiento: 'Retiro', valor: -540, saldoDisponible: 0 });",
                  "    pm.expect(savings.movimientos[0].fecha).to.match(/^2022-02-08T00:00:00/);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{accountsBaseUrl}}/api/reportes?fechaInicio=2022-02-01&fechaFin=2022-02-28&clienteId={{marianelaCustomerId}}"
          }
