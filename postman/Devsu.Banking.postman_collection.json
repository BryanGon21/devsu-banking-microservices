          "name": "Create account 478758",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let body = {};",
                  "try { body = pm.response.json(); } catch (error) { console.log(error); }",
                  "const retryKey = 'retryAccount478758';",
                  "if (pm.response.code === 409 && body.code === 'cliente_no_disponible') {",
                  "    const attempt = Number(pm.collectionVariables.get(retryKey) || 0) + 1;",
                  "    pm.collectionVariables.set(retryKey, attempt);",
                  "    if (attempt < 30) {",
                  "        console.log('Esperando proyección de Jose. Intento ' + attempt + '/30');",
                  "        postman.setNextRequest(pm.info.requestName);",
                  "        setTimeout(function () {}, 500);",
                  "    } else {",
                  "        pm.test('La proyección de Jose llega a tiempo', function () { throw new Error('Timeout esperando la proyección'); });",
                  "    }",
                  "} else {",
                  "    pm.collectionVariables.unset(retryKey);",
                  "    pm.test('Cuenta 478758 creada', function () {",
                  "        pm.response.to.have.status(201);",
                  "        pm.expect(body).to.include({ numeroCuenta: '478758', tipoCuenta: 'Ahorros', saldoInicial: 2000, saldoActual: 2000, estado: true });",
                  "        pm.expect(body.clienteId).to.eql(pm.collectionVariables.get('joseCustomerId'));",
                  "    });",
                  "}"
                ]
              }
            }
