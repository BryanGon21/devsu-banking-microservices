# Local-development values only. Replace every password before using this stack
# outside an isolated developer workstation.
SQLSERVER_SA_PASSWORD=LocalOnly_SqlServer_42!
CUSTOMERS_DB_PASSWORD=LocalOnly_Customers_42!
ACCOUNTS_DB_PASSWORD=LocalOnly_Accounts_42!
RABBITMQ_USER=devsu_local
RABBITMQ_PASSWORD=LocalOnly_RabbitMq_42!

# Host ports can be changed when a local service already uses the defaults.
SQLSERVER_HOST_PORT=1433
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672
CUSTOMERS_API_HOST_PORT=8081
ACCOUNTS_API_HOST_PORT=8082
